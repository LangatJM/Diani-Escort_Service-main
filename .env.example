# Supabase configuration (optional)
# If these are left unset, the app runs in DEMO MODE with bundled sample companions
# so the UI is fully browsable without a backend.
#
# To enable the real backend, copy this file to ".env" and fill in your values
# from your Supabase project dashboard (Settings > API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
